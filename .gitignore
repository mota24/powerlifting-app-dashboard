# Environment variables — motif large : .env*.local ne couvrait que les
# fichiers finissant EXACTEMENT par ".local" (ex: .env.local.txt, trouvé
# dans l'historique git — vide, mais aurait pu ne pas l'être, passait au
# travers de l'ancien motif).
.env
.env.*
!.env.example

